# Production: a PostgreSQL connection string (e.g. from Supabase, Neon or Render).
# Leave empty for local testing: an embedded Postgres is stored in ./.data
DATABASE_URL=""

# Main domain. Each store lives on its own subdomain of it:
#   ROOT_DOMAIN="scanexit.com"  ->  https://shoprite-lekki.scanexit.com
# Point a wildcard DNS record (*.scanexit.com) and the main domain at the app.
# Local testing: "localhost:3000" gives http://demo.localhost:3000
ROOT_DOMAIN="localhost:3000"

# Single-store mode (the live demo): the main address itself is this store, no subdomains needed.
#   demo.scanexit.com -> ROOT_DOMAIN="demo.scanexit.com" and DEFAULT_STORE="demo"
# Leave empty for the real multi-store app, where each store has its own subdomain.
DEFAULT_STORE=""

# Paystack secret key (sk_test_... or sk_live_...).
# Without a key (and without SIMULATE_PAYMENTS below) checkout is refused, never free.
PAYSTACK_SECRET_KEY=""

# LOCAL TESTING ONLY: "true" makes "Pay now" simulate a successful payment.
# Ignored whenever PAYSTACK_SECRET_KEY is set. Never set this on a server a store uses.
SIMULATE_PAYMENTS="false"

# Secret used to sign receipt QR codes. Use a long random string.
RECEIPT_SECRET="change-me-to-a-long-random-string"

# PIN for the owner page (/owner on the main domain), where you create stores. 8+ characters.
# Each store's staff and admin PINs are set on that page and stored hashed in the database.
OWNER_PIN="change-me-long-owner-pin"
